# Copy to .env and fill in. .env is gitignored; never commit keys.
# C.7 Benchmark Data Sources (SPEC.md section 2)
# file = stored catalog in sample_data/ (default, used by tests); api = live pull
BENCHMARK_SOURCE=file
ARTIFICIAL_ANALYSIS_API_URL=https://artificialanalysis.ai/api/v2/data/llms/models
ARTIFICIAL_ANALYSIS_API_KEY=
# Public, no key
MODELS_DEV_API_URL=https://models.dev/api.json
# Fallback for context window; the model list is public, the key is optional
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
