# Copy to .env and fill in. .env is gitignored; never commit keys.
# C.7 Benchmark Data Sources (SPEC.md section 2)
# api = latest pulled snapshot (default); file = the prototype's hand-entered catalog in sample_data/
BENCHMARK_SOURCE=api
# Free tier, paged. The legacy /api/v2/data/llms/models was retired 2026-11-04.
ARTIFICIAL_ANALYSIS_API_URL=https://artificialanalysis.ai/api/v2/language/models/free
ARTIFICIAL_ANALYSIS_API_KEY=
# Public, no key
MODELS_DEV_API_URL=https://models.dev/api.json
# Fallback for context window; the model list is public, the key is optional
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
# Snapshot store for api mode (ADR-0005); default data/benchmark_snapshots.sqlite3
BENCHMARK_SNAPSHOT_DB=
# C.8 Language model runtime (SPEC.md section 3 "Adapter"): LM Studio / Bionic, local only
LLM_RUNTIME_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
